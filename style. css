* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

body {
    background-color: #fafafa;
    color: #111;
}

/* Navbar */
.navbar {
    background-color: rgba(255, 255, 255, 0.9);
    padding: 15px 40px;
    position: sticky;
    top: 0;
    z-index: 100;
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
}

.logo {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-decoration: none;
    color: #000;
    line-height: 1.1;
}

.nav-links {
    display: flex;
    gap: 25px;
}

.nav-links a {
    text-decoration: none;
    color: #222;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
}

.nav-links a.active {
    color: #caba88;
}

.nav-icons {
    display: flex;
    gap: 18px;
    font-size: 14px;
}

/* Hero Section */
.hero {
    position: relative;
    height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
}

.hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
}

.hero-card {
    position: relative;
    z-index: 2;
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    padding: 40px 30px;
    border-radius: 16px;
    text-align: center;
    max-width: 450px;
}

.hero-card h2 {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: 1.5px;
    margin-bottom: 15px;
    color: #000;
}

.hero-card p {
    font-size: 12px;
    color: #333;
    line-height: 1.6;
    margin-bottom: 25px;
}

.hero-btns {
    display: flex;
    justify-content: center;
    gap: 12px;
}

.btn {
    padding: 10px 24px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: 20px;
}

.btn-dark {
    background-color: #000;
    color: #fff;
    border: 1px solid #000;
}

.btn-outline {
    background-color: transparent;
    border: 1px solid #666;
    color: #000;
}

/* Categories Section */
.categories {
    max-width: 1100px;
    margin: 50px auto;
    padding: 0 20px;
}

.section-title {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 25px;
    color: #111;
}

.categories-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 250px 250px;
    gap: 20px;
}

.category-card {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
}

.category-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.item-men {
    grid-column: 1 / 2;
    grid-row: 1 / 3;
}

.item-women {
    grid-column: 2 / 3;
    grid-row: 1 / 2;
}

.item-shoes {
    grid-column: 2 / 3;
    grid-row: 2 / 3;
}

.card-overlay {
    position: absolute;
    bottom: 15px;
    left: 15px;
    background: rgba(30, 30, 30, 0.75);
    backdrop-filter: blur(5px);
    padding: 8px 20px;
    border-radius: 6px;
}

.card-overlay span {
    font-size: 13px;
    font-weight: 600;
    color: #ffffff;
}

/* Footer Style */
footer {
    background-color: #fff;
    padding: 40px 20px;
    border-top: 1px solid #eee;
    margin-top: 60px;
}

.footer-container {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
}

.footer-logo {
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 1px;
}

.footer-brand p {
    font-size: 10px;
    color: #888;
    margin-top: 12px;
    max-width: 180px;
    line-height: 1.4;
}

.footer-links {
    display: flex;
    gap: 40px;
}

.footer-links div {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.footer-links a {
    color: #555;
    text-decoration: none;
    font-size: 11px;
}
